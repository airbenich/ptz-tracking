[Unit]
Description=PTZ Tracking - Real-time Person Tracking
After=network.target
Documentation=https://github.com/username/ptz-tracking

[Service]
Type=simple
User=ptztracking
Group=ptztracking
WorkingDirectory=/opt/ptz-tracking

# Virtual Environment Python
Environment="PATH=/opt/ptz-tracking/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Headless-Modus für Service
ExecStart=/opt/ptz-tracking/venv/bin/python /opt/ptz-tracking/src/main.py --daemon --headless

# Restart-Konfiguration
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Graceful Shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ptz-tracking

# Sicherheit
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ptz-tracking/logs /opt/ptz-tracking/output

# Ressourcen-Limits
LimitNOFILE=4096
MemoryLimit=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
